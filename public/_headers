# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Tina's editor and the internal how-it-works page must never appear in Google.
/admin/*
  X-Robots-Tag: noindex, nofollow
/sop/*
  X-Robots-Tag: noindex, nofollow
# The Beacon scans carry the children's rota, volunteer names and the week's
# giving figures. The Upcoming page sets noimageindex, but that only governs
# images found on that page, and the footer of every page links one of these
# files directly. Setting it on the file itself is what actually holds.
/images/beacon/*
  X-Robots-Tag: noindex, noimageindex

# Fingerprinted build assets never change — cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and icons: a week, revalidate after.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Root-level icons only — listed explicitly so this cannot overlap /images/*
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
