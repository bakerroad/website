# Copy to .env and fill in. Never commit .env — it is gitignored.
# The live values also live in the macOS Keychain under brbc-website/*
# (look them up with the account flag: security find-generic-password -a brbc-website/TINA_TOKEN).

# From app.tina.io -> your project -> Overview  (create under bakerroadbaptist@gmail.com)
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Search indexer token from app.tina.io -> project -> Search -> Generate.
# NOT a random string. An invalid value switches search on with a bad token and
# breaks the editor; an empty value simply leaves search off. Optional.
TINA_SEARCH_TOKEN=

# YouTube Data API v3 key (Google Cloud project under bakerroadbaptist@gmail.com)
YOUTUBE_API_KEY=

# Planning Center -> Developer -> Personal Access Token (Baker Road's own PCO
# account, not another church's). A token is a PAIR: the App ID and the Secret.
PCO_APP_ID=
PCO_SECRET=

# YouTube OAuth, used by the sermon sync to read the church's own uploads.
# Same Google Cloud project. The refresh token is in the Keychain, not here.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
