---
/**
 * Planning Center giving, opened from the page.
 *
 * Subsplash let us drop its form straight into a frame on this page. Planning
 * Center does not: their guidance is that older iframe embeds broke donations
 * for some people and tripped browser security warnings, so the only method
 * they support is the Church Center modal — a link that the script below turns
 * into a full-screen overlay served by Planning Center itself.
 *
 * That is why this section is a button and not a panel. The form cannot sit in
 * the page any more, so pretending otherwise would mean shipping something the
 * provider will not stand behind on the one page where a failure costs the
 * church money.
 *
 * The script is loaded here rather than in <head> so that the button and the
 * thing that makes it work cannot drift into separate files. It is a plain,
 * non-deferred <script src>, so it runs while the page is still parsing and
 * its own DOMContentLoaded hook — the one that appends the overlay — still
 * fires. It attaches a delegated click handler to window and calls start() on
 * itself, so there is nothing here to initialise.
 *
 * The overlay needs HTTPS and a desktop browser. On a phone, and on anything
 * served over plain HTTP, the script quietly falls back to opening the giving
 * page in a new tab. The plain link underneath is therefore not decoration: it
 * is the same destination for anyone the overlay cannot serve, it is what a
 * reader with JavaScript off gets when they click the button itself, and it is
 * the only route on which Apple Pay works — Apple disallows it inside a frame,
 * so the overlay never offers it.
 */
import { site } from "../lib/site";
const url = site.givingUrl || "";
---
{url && (
  <section class="sec give-sec">
    <script is:inline src="https://js.churchcenter.com/modal/v1"></script>
    <div class="wrap">
      <p class="eyebrow">Online</p>
      <h2>Give online</h2>

      <div class="give-box">
        <p class="give-lede">A one-time gift or a recurring one, by card or bank draft.</p>

        <p class="give-act">
          {/* Without the script this is an ordinary link to the giving page,
              which is the behaviour we want it to degrade to. */}
          <a class="btn btn-p btn-give" href={url} data-open-in-church-center-modal="true">Give now</a>
          <a class="give-alt" href={url} target="_blank" rel="noopener">Or open the giving page on its own</a>
        </p>

        <p class="quiet">
          Handled by Planning Center Giving, the church's own giving provider.
          Baker Road's website never sees your card details.
        </p>
      </div>
    </div>
  </section>
)}
