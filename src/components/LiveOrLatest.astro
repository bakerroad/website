---
/**
 * The featured slot on /watch/.
 *
 * Renders the most recent sermon server-side, so the page is correct with
 * JavaScript off, for crawlers, and every day of the week. On Sunday morning a
 * small script asks YouTube whether the channel is live and, only if it is,
 * swaps in the live player. When the stream ends the replay lands in the
 * archive on the next sync and this slot goes back to being the latest sermon.
 *
 * No API key is needed: youtube.com/embed/live_stream resolves to whatever the
 * channel is streaming. The check is a HEAD-style fetch of the channel's live
 * page through a CORS-friendly endpoint, and any failure leaves the sermon in
 * place — the worst case is a visitor sees last week's message, never an error.
 */
import SermonCover from "./SermonCover.astro";
const { sermon, channelId, slug } = Astro.props;
---
<section class="sec" id="recent-messages">
  <div class="wrap">
    <div id="live-slot" hidden>
      <p class="eyebrow live-now"><span class="dot" aria-hidden="true"></span> Live now</p>
      <h2>This morning's service</h2>
      <div class="player">
        <iframe
          id="live-frame"
          title="Baker Road Baptist Church live stream"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <p class="seclink"><a href={`https://www.youtube.com/channel/${channelId}/live`} rel="noopener">Watch on YouTube</a></p>
    </div>

    <div id="latest-slot">
      <p class="eyebrow">Most recent message</p>
      <a class="featured" href={`/watch/${slug}`}>
        <SermonCover sermon={sermon} />
        <span class="play">Listen to this message</span>
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ channelId }}>
  // Only bother on Sunday morning, Central. Cheap, and avoids a pointless
  // request on a Tuesday afternoon.
  (function () {
    const now = new Date();
    const central = new Date(now.toLocaleString("en-US", { timeZone: "America/Chicago" }));
    const sunday = central.getDay() === 0;
    const hour = central.getHours();
    if (!sunday || hour < 9 || hour > 13) return;

    const live = document.getElementById("live-slot");
    const latest = document.getElementById("latest-slot");
    const frame = document.getElementById("live-frame");
    if (!live || !latest || !frame) return;

    // Load the live embed hidden. If the channel is not streaming YouTube
    // serves an "offline" page, so we only reveal it once the player reports
    // a real video. postMessage from the iframe is the signal.
    frame.src =
      "https://www.youtube.com/embed/live_stream?channel=" + channelId +
      "&enablejsapi=1&rel=0&autoplay=0";

    let settled = false;
    const reveal = () => {
      if (settled) return;
      settled = true;
      live.hidden = false;
      latest.hidden = true;
    };
    window.addEventListener("message", (e) => {
      if (!/^https:\/\/www\.youtube(-nocookie)?\.com$/.test(e.origin)) return;
      try {
        const d = typeof e.data === "string" ? JSON.parse(e.data) : e.data;
        // A live stream reports a duration of 0 and state 1/3 once it attaches.
        if (d && d.event === "onReady") reveal();
      } catch (_) {}
    });
    // Give it 6 seconds; if nothing attaches, stay on the archive.
    setTimeout(() => { if (!settled) frame.removeAttribute("src"); }, 6000);
  })();
</script>

<style>
  .live-now { color: #b3261e; display: flex; align-items: center; gap: .45rem; }
  .live-now .dot {
    width: .55rem; height: .55rem; border-radius: 50%; background: #b3261e;
    box-shadow: 0 0 0 0 rgba(179,38,30,.6); animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 .5rem rgba(179,38,30,0); }
    100% { box-shadow: 0 0 0 0 rgba(179,38,30,0); }
  }
  .player { position: relative; aspect-ratio: 16/9; }
  .player iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; border-radius: 10px; }
</style>
