---
/** One issue of The Beacon, as part of the page rather than a picture on it.
 *
 *  Whatever the office uploaded has already been prepared by the build
 *  (scripts/lib/beacon-prepare.mjs): a PDF is taken apart into its panels and
 *  each page is laid out again here, the way it was printed, on the site's own
 *  background. On a phone the same panels stack in reading order, full width,
 *  which is far easier to read than a shrunken sheet. Any other picture is
 *  shown as it is. The printed PDF stays one tap away for anyone who wants it.
 *
 *  If the build has not prepared this issue (a local preview before the first
 *  build, say), the pictures are shown as uploaded and a PDF as a download. */
import { imageSize, publicFileExists } from "../lib/imagesize";

interface Page { image?: string; alt?: string }
interface Highlight { title?: string; when?: string; body?: string }
const { issue } = Astro.props as { issue: any };
const day = String(issue.date).slice(0, 10);

const prepared = Object.values(import.meta.glob("../generated/beacon.json", { eager: true }) as Record<string, any>)
  .map((m) => m.default ?? m)[0]?.[day];

const isPdf = (s?: string) => /\.pdf$/i.test(s ?? "");
const entries: Page[] = [...(issue.pdf ? [{ image: issue.pdf }] : []), ...(issue.pages ?? [])];
const uploaded: Page[] = entries.filter((p: Page) => publicFileExists(p.image));
const missing = entries.length - uploaded.length;

const pdfs = prepared?.pdfs ?? uploaded.filter((p) => isPdf(p.image)).map((p) => ({ src: p.image, download: `The-Beacon-${day}.pdf` }));
const blocks: any[] = prepared?.blocks ?? uploaded.filter((p) => !isPdf(p.image)).map((p) => {
  const size = imageSize(p.image);
  return { kind: "image", src: p.image, width: size?.width, height: size?.height, alt: p.alt || "" };
});
const pdf = pdfs[0];
const sheets = blocks.filter((b) => b.kind === "sheet").length;
const pdfMeta = pdf ? [pdf.pages ? `${pdf.pages} page${pdf.pages === 1 ? "" : "s"}` : "", pdf.kb ? (pdf.kb > 1024 ? `${(pdf.kb / 1024).toFixed(1)} MB` : `${pdf.kb} KB`) : ""].filter(Boolean).join(" · ") : "";
const highlights: Highlight[] = (issue.highlights ?? []).filter((h: Highlight) => h.title);
---
{pdf && (
  <p class="beacon-dl">
    <a href={pdf.src} download={pdf.download}>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Download the printed Beacon
    </a>
    {pdfMeta && <span>PDF · {pdfMeta}</span>}
  </p>
)}

{blocks.length > 0 ? (
  <div class="beacon-issue">
    {blocks.map((b, bi) => b.kind === "sheet" ? (
      <div class="bsheet" role="group" aria-label={b.alt || `The Beacon, page ${b.page}`}
           style={`--aspect:${b.aspect};--sheet-max:${Math.round(b.aspect * 900)}px`}>
        {b.panels.map((p: any, i: number) => (
          <a class="bpanel" href={p.src} target="_blank" rel="noopener"
             aria-label={`Page ${b.page}, panel ${i + 1} of ${b.panels.length}, full size`}
             style={`--l:${p.left}%;--t:${p.top}%;--w:${p.w}%;--h:${p.h}%`}>
            <img src={p.src} alt="" width={p.width} height={p.height}
                 loading={bi === 0 && i < 4 ? "eager" : "lazy"} decoding="async" />
          </a>
        ))}
      </div>
    ) : (
      <a class="bimage" href={b.src} target="_blank" rel="noopener"
         style={b.width ? `--page-w:${b.width}px` : undefined}
         aria-label={`${b.alt || `The Beacon, picture ${bi + 1}`}, full size`}>
        <img src={b.src} alt={b.alt || `The Beacon, picture ${bi + 1}`} width={b.width} height={b.height}
             loading={bi === 0 ? "eager" : "lazy"} decoding="async" />
      </a>
    ))}
    <p class="beacon-tip">{sheets ? "Tap any panel to see it full size." : "Tap a picture to see it full size."}</p>
  </div>
) : pdf ? (
  <p class="beacon-none">This week's Beacon is ready to download above.</p>
) : (
  <p class="beacon-none">
    {missing > 0
      ? "The pages for this issue are still being added. Check back shortly."
      : "This issue has no pages yet."}
  </p>
)}

{highlights.length > 0 && (
  <div class="beacon-hi">
    <h2>This week at a glance</h2>
    <ul>
      {highlights.map((h) => (
        <li>
          <p class="t">{h.title}</p>
          {h.when && <p class="w">{h.when}</p>}
          {h.body && <p class="b">{h.body}</p>}
        </li>
      ))}
    </ul>
  </div>
)}
