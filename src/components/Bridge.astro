  <div class="wrap bridge-in">
    <svg viewBox="0 0 600 132" role="img" aria-label="Line drawing of the Fred Hartman Bridge over the Houston Ship Channel in Baytown">
              <g stroke-linecap="round">
          <path d="M182 120 L196 30 M218 120 L204 30" />
          <path d="M189 76 L211 76" />
          <line x1="198" y1="32" x2="180" y2="119" />
          <line x1="202" y1="32" x2="220" y2="117" />
