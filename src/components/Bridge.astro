---
/** Line drawing of the Fred Hartman Bridge over the Houston Ship Channel.
 *  It is the landmark everyone in Baytown knows, and it says "we are from
 *  here" faster than a sentence could. Carried over from the approved draft. */
const { caption = "Baytown, Texas · Harris County" } = Astro.props;
