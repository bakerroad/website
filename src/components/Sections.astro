---
/** Renders the `sections` array from any page JSON. Chooses a card grid or a
 *  labelled row list depending on whether the items carry a time/detail. */
interface Item { title?: string; meta?: string; when?: string; body?: string; linkText?: string; linkUrl?: string; link2Text?: string; link2Url?: string; image?: string; }
interface Section { eyebrow?: string; heading?: string; body?: string; note?: string; items?: Item[]; linkText?: string; linkUrl?: string; image?: string; imageAlt?: string; }
import { site, telHref } from "../lib/site";
import { imageSize } from "../lib/imagesize";
const { sections = [], layout = "grid" } = Astro.props as { sections: Section[]; layout?: string };

/** Stable anchor from a title, so the nav dropdowns can point at a card. */
const anchor = (t?: string) =>
  (t || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

/** A link written as "@givingUrl" is filled in from Church Info, so the office
 *  updates one field in one place instead of hunting through pages. */
/** "@mailto" -> the church email, "@tel" -> a tap-to-call link, "@givingUrl"
 *  etc. -> the matching field in Church Info. One place to change an address. */
const resolve = (url?: string) => {
  if (!url?.startsWith("@")) return url || "";
  if (url === "@mailto") return site.email ? `mailto:${site.email}` : "";
  if (url === "@tel") return telHref(site.phone);
  return (site as any)[url.slice(1)] || "";
};

const isRowList = (s: Section) =>
  (s.items ?? []).length > 2 && (s.items ?? []).every((i) => i.meta && !i.linkUrl);

/** Staff and deacons: every item is a person with a role under their name, and
 *  at least one of them has a photograph. Rendered as portrait cards instead of
 *  the labelled rows, which have nowhere to put a face. */
const isPeople = (s: Section) =>
  (s.items ?? []).length > 1 &&
  (s.items ?? []).every((i) => i.meta && !i.linkUrl && !i.when) &&
  (s.items ?? []).some((i) => i.image);

/** Initials, so a person still gets a card while the office finds a photo. */
const initials = (t?: string) =>
  (t || "").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---
{sections.map((s) => (
  <section class="sec" id={anchor(s.heading || s.eyebrow)}>
    <div class="wrap">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.heading && <h2>{s.heading}</h2>}
      {s.body && <div class="body">{s.body.split(/\n{2,}/).map((para) => <p style="margin-bottom:.85rem">{para}</p>)}</div>}

      {s.image && (
        <figure class="secfig">
          <img src={s.image} alt={s.imageAlt ?? ""} loading="lazy" decoding="async"
               width={imageSize(s.image)?.width} height={imageSize(s.image)?.height} />
        </figure>
      )}

      {(s.items ?? []).length > 0 && (
        isPeople(s) ? (
          <div class="people">
            {s.items!.map((i) => (
              <article class="person" id={anchor(i.title)}>
                {i.image ? (
                  <img class="pic" src={i.image} alt={i.title || ""} loading="lazy" decoding="async"
                       width={imageSize(i.image)?.width} height={imageSize(i.image)?.height} />
                ) : (
                  <p class="pic nopic" aria-hidden="true">{initials(i.title)}</p>
                )}
                <div class="ptext">
                  {i.title && <h3>{i.title}</h3>}
                  {i.meta && <p class="meta">{i.meta}</p>}
                  {i.body && <p>{i.body}</p>}
                </div>
              </article>
            ))}
          </div>
        ) : isRowList(s) ? (
          <div class="rows">
            {s.items!.map((i) => (
              <div class="r">
                <div class="m">{i.meta}</div>
                <div>
                  {i.title && <h3>{i.title}</h3>}
                  {i.body && <p>{i.body}</p>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class={layout === "stack" ? "cards stack" : "cards"}>
            {s.items!.map((i) => (
              <article class={i.image ? "card haspic" : "card"} id={anchor(i.title)}>
                {i.image && (
                  <img src={i.image} alt={i.title || ""} loading="lazy" decoding="async"
                       width={imageSize(i.image)?.width} height={imageSize(i.image)?.height} />
                )}
                <div class="cbody">
                  <div class="chead">
                    {i.title && <h3>{i.title}</h3>}
                    {i.meta && <p class="meta">{i.meta}</p>}
                  </div>
                  {i.body && <p>{i.body}</p>}
                  {i.when && <p class="when">{i.when}</p>}
                  {(resolve(i.linkUrl) && i.linkText) || (resolve(i.link2Url) && i.link2Text) ? (
                    <div class="acts">
                      {resolve(i.linkUrl) && i.linkText && (
                        <a class="act act-1" href={resolve(i.linkUrl)}>{i.linkText}</a>
                      )}
                      {resolve(i.link2Url) && i.link2Text && (
                        <a class="act act-2" href={resolve(i.link2Url)}>{i.link2Text}</a>
                      )}
                    </div>
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        )
      )}

      {s.linkText && resolve(s.linkUrl) && (
        <p class="seclink"><a href={resolve(s.linkUrl)}>{s.linkText}</a></p>
      )}

      {s.note && <p class="note">{s.note}</p>}
    </div>
  </section>
))}
