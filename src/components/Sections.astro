---
/** Renders the `sections` array from any page JSON. Chooses a card grid or a
 *  labelled row list depending on whether the items carry a time/detail. */
interface Item { title?: string; meta?: string; body?: string; linkText?: string; linkUrl?: string; }
interface Section { eyebrow?: string; heading?: string; body?: string; note?: string; items?: Item[]; }
import { site } from "../lib/site";
const { sections = [] } = Astro.props as { sections: Section[] };

/** A link written as "@givingUrl" is filled in from Church Info, so the office
 *  updates one field in one place instead of hunting through pages. */
const resolve = (url?: string) => {
  if (!url?.startsWith("@")) return url || "";
  if (url === "@mailto") return site.email ? `mailto:${site.email}` : "";
  return (site as any)[url.slice(1)] || "";
};

const isRowList = (s: Section) =>
  (s.items ?? []).length > 2 && (s.items ?? []).every((i) => i.meta && !i.linkUrl);
---
{sections.map((s) => (
  <section class="sec">
    <div class="wrap">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.heading && <h2>{s.heading}</h2>}
      {s.body && <div class="body">{s.body.split(/\n{2,}/).map((para) => <p style="margin-bottom:.85rem">{para}</p>)}</div>}

      {(s.items ?? []).length > 0 && (
        isRowList(s) ? (
          <div class="rows">
            {s.items!.map((i) => (
              <div class="r">
                <div class="m">{i.meta}</div>
                <div>
                  {i.title && <h3>{i.title}</h3>}
                  {i.body && <p>{i.body}</p>}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="cards">
            {s.items!.map((i) => (
              <article class="card">
                {i.meta && <p class="meta">{i.meta}</p>}
                {i.title && <h3>{i.title}</h3>}
                {i.body && <p>{i.body}</p>}
                {resolve(i.linkUrl) && i.linkText && <a href={resolve(i.linkUrl)}>{i.linkText}</a>}
              </article>
            ))}
          </div>
        )
      )}

      {s.note && <p class="note">{s.note}</p>}
    </div>
  </section>
))}
