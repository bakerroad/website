---
import "../styles/global.css";
import { site, NAV, telHref, emailHref, currentBeaconHref } from "../lib/site";

interface Props { title: string; description?: string; noindex?: boolean; ogImage?: string; ogType?: string; schema?: any; }
const { title, description = "", noindex = false, ogImage, ogType = "website", schema } = Astro.props;
const socialImage = new URL(ogImage || "/images/social-card.jpg", Astro.site).href;

/** "Tuesday — 9:00 AM – 2:00 PM" -> "Tu 09:00-14:00" for schema.org openingHours. */
const hours = (site.officeHours || [])
  .filter((h: any) => h.hours && !/closed/i.test(h.hours))
  .map((h: any) => {
    const m = h.hours.match(/(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?\s*[\u2013\u2014-]\s*(\d{1,2})(?::(\d{2}))?\s*(AM|PM)/i);
    if (!m) return null;
    const to24 = (hh: string, mm: string, ap: string) => { let n = +hh % 12; if (/pm/i.test(ap)) n += 12; return `${String(n).padStart(2, "0")}:${mm || "00"}`; };
    return `${h.day.slice(0, 2)} ${to24(m[1], m[2], m[3] || m[6])}-${to24(m[4], m[5], m[6])}`;
  }).filter(Boolean);

const churchSchema = {
  "@context": "https://schema.org", "@type": "Church",
  "@id": new URL("/#church", Astro.site).href,
  name: site.churchName, telephone: site.phone, email: site.email || undefined,
  url: Astro.site?.href, image: socialImage, logo: new URL("/images/logo.png", Astro.site).href,
  foundingDate: site.foundingYear || undefined,
  address: { "@type": "PostalAddress", streetAddress: site.street, addressLocality: site.city, addressRegion: "TX", postalCode: site.zip, addressCountry: "US" },
  geo: site.latitude ? { "@type": "GeoCoordinates", latitude: site.latitude, longitude: site.longitude } : undefined,
  hasMap: site.mapUrl || undefined,
  areaServed: { "@type": "City", name: "Baytown", containedInPlace: { "@type": "AdministrativeArea", name: "Harris County, Texas" } },
  openingHours: hours.length ? hours : undefined,
  sameAs: [site.facebookUrl, site.youtubeUrl, site.yelpUrl].filter(Boolean),
};
// Cloudflare serves /about/ (and 307s /about to it), and the sitemap lists the
// slashed form, so the canonical must be the slashed form too.
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : Astro.url.pathname + "/";
const year = new Date().getFullYear();
const tel = telHref(site.phone);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-37WGNT2TFM"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-37WGNT2TFM');
        </script>
      </>
    )}
    <link rel="canonical" href={new URL(path, Astro.site).href} />
    <meta property="og:site_name" content={site.churchName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={new URL(path, Astro.site).href} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Baytown" />
    {site.latitude && <meta name="geo.position" content={`${site.latitude};${site.longitude}`} />}
    {site.latitude && <meta name="ICBM" content={`${site.latitude}, ${site.longitude}`} />}
    <meta name="theme-color" content="#224E9B" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Source+Sans+3:wght@400;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(churchSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="hdr">
      <div class="wrap hdr-in">
        <a class="brand" href="/">
          <img src="/images/logo.png" alt="" width="44" height="44" />
          <span>{site.churchName}<small>{site.city}, {site.state}</small></span>
        </a>
        <button class="navtoggle" id="navtoggle" aria-expanded="false" aria-controls="nav">Menu</button>
        <nav class="nav" id="nav" aria-label="Main">
          {NAV.map((n: any) => (
            <div class={n.children ? "navitem has-sub" : "navitem"}>
              <a href={n.href} aria-current={n.href === path ? "page" : undefined}>{n.label}</a>
              {n.children && (
                <>
                  <button class="subtoggle" type="button" aria-expanded="false"
                          aria-label={`Show ${n.label} pages`}>▾</button>
                  <ul class="sub">
                    {n.children.map((c: any) => (
                      <li><a href={c.href}>{c.label}</a></li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          ))}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="ftr">
      <div class="wrap">
        <div class="ftr-grid">
          <div>
            <h2>Where we are</h2>
            <p><strong>{site.churchName}</strong></p>
            <p>{site.street}</p>
            <p>{site.city}, {site.state} {site.zip}</p>
            {site.mapUrl && <p style="margin-top:.5rem"><a href={site.mapUrl}>Get directions</a></p>}
          </div>
          <div>
            <h2>Sundays</h2>
            <ul>{site.sunday.map((s: any) => <li><strong>{s.time}</strong> — {s.label}</li>)}</ul>
            <h2 style="margin-top:1rem">Wednesdays</h2>
            <ul>{site.wednesday.map((s: any) => <li><strong>{s.time}</strong> — {s.label}</li>)}</ul>
          </div>
          <div>
            <h2>Office hours</h2>
            <ul>{site.officeHours.map((h: any) => <li>{h.day} — {h.hours}</li>)}</ul>
          </div>
          <div>
            <h2>Get in touch</h2>
            <ul>
              {tel && <li><a href={tel}>{site.phone}</a></li>}
              {site.email && <li><a href={emailHref()}>Email us</a></li>}
              {site.facebookUrl && <li><a href={site.facebookUrl}>Facebook</a></li>}
              {site.youtubeUrl && <li><a href={site.youtubeUrl}>YouTube</a></li>}
            </ul>
          </div>
        </div>
        <nav class="ftr-map" aria-label="All pages">
          <h2>Every page on this site</h2>
          <ul>
            {NAV.map((n: any) => (
              <li><a href={n.href} aria-current={n.href === path ? "page" : undefined}>{n.label}</a></li>
            ))}
            {/* "Newsletter" is the word people go looking for, even though the
                page is now called Upcoming. This opens this week's front page
                picture directly, and falls back to /upcoming/ in a week with
                no issue. */}
            <li><a href={currentBeaconHref()}>Newsletter</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
          </ul>
        </nav>

        <div class="bot">
          <span>© {year} {site.churchName}</span>
          <a href="/privacy-policy/">Privacy policy</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var b = document.getElementById("navtoggle"), n = document.getElementById("nav");
        if (!b || !n) return;
        b.addEventListener("click", function () {
          var open = n.classList.toggle("open");
          b.setAttribute("aria-expanded", String(open));
        });
        // Sub-menu carets. On a phone there is no hover, so these are the control.
        n.querySelectorAll(".subtoggle").forEach(function (t) {
          t.addEventListener("click", function () {
            var item = t.parentElement;
            var open = item.classList.toggle("open");
            t.setAttribute("aria-expanded", String(open));
          });
        });
        // Escape closes any open dropdown and returns focus to the tab.
        n.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          var item = e.target.closest(".navitem");
          if (!item) return;
          item.classList.remove("open");
          var t = item.querySelector(".subtoggle");
          if (t) t.setAttribute("aria-expanded", "false");
          var a = item.querySelector("a");
          if (a) a.focus();
        });
      })();
    </script>
  </body>
</html>
