---
import InnerPage from "../layouts/InnerPage.astro";
import page from "../../content/pages/contact.json";
import { site, telHref, emailHref } from "../lib/site";
const tel = telHref(site.phone);
---
<InnerPage page={page}>
  <section class="sec" id="map">
    <div class="wrap">
      <p class="eyebrow">Find us</p>
      <h2>900 W. Baker Rd, Baytown</h2>
      <div class="mapwrap">
        <iframe
          title="Map to Baker Road Baptist Church"
          src={`https://www.google.com/maps?q=${encodeURIComponent(site.street + ", " + site.city + ", TX " + site.zip)}&output=embed`}
          width="100%" height="380" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
      {site.mapUrl && <p class="seclink"><a href={site.mapUrl}>Open in Google Maps</a></p>}
    </div>
  </section>
  <section class="sec" style="order:-1">
    <div class="wrap">
      <div class="cards">
        <article class="card">
          <p class="meta">Where we are</p>
          <h3>{site.churchName}</h3>
          <p>{site.street}<br />{site.city}, {site.state} {site.zip}</p>
          {site.mapUrl && <a href={site.mapUrl}>Get directions</a>}
        </article>
        <article class="card">
          <p class="meta">By phone</p>
          <h3>{site.phone}</h3>
          <p>A real person answers during office hours.</p>
          {tel && <a href={tel}>Call the office</a>}
        </article>
        <article class="card">
          <p class="meta">By email</p>
          <h3>Write to us</h3>
          <p>The office reads everything that comes in.</p>
          {site.email && <a href={emailHref()}>Email us</a>}
        </article>
        <article class="card">
          <p class="meta">Office hours</p>
          <h3>During the week</h3>
          <p>{site.officeHours.map((h: any) => `${h.day}: ${h.hours}`).join(" · ")}</p>
        </article>
      </div>
    </div>
  </section>
</InnerPage>
