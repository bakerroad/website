---
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import GivingEmbed from "../components/GivingEmbed.astro";
import page from "../../content/pages/give.json";
const [why, ...rest] = page.sections ?? [];
---
<Base title={page.title} description={page.metaDescription}>
  <div class="phead">
    <div class="wrap">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.headline}</h1>
      {page.intro && <p class="lede">{page.intro}</p>}
    </div>
  </div>

  <!-- order the church asked for: why we give, then the form, then the other ways -->
  <Sections sections={why ? [why] : []} />
  <GivingEmbed />
  <Sections sections={rest} />
</Base>
