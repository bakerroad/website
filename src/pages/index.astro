---
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import Bridge from "../components/Bridge.astro";
import page from "../../content/pages/home.json";
import { site, telHref, upcomingEvents, TZ } from "../lib/site";
import { imageSize } from "../lib/imagesize";
const tel = telHref(site.phone);
const events = upcomingEvents().slice(0, 3);

/** "October 4 – 31" for a run of days; a single date otherwise. */
const dayKey = (d: Date) => d.toLocaleDateString("en-CA", { timeZone: TZ }); // YYYY-MM-DD
const fmt = (d: Date, o: any) => d.toLocaleDateString("en-US", { timeZone: TZ, ...o });
const fmtRange = (e: any) => {
  const a = new Date(e.start);
  const b = e.end ? new Date(e.end) : null;
  if (!b || dayKey(b) === dayKey(a)) return fmt(a, { weekday: "short", month: "long", day: "numeric" });
  const sameMonth = fmt(a, { month: "long" }) === fmt(b, { month: "long" });
  return `${fmt(a, { month: "long", day: "numeric" })} – ${fmt(b, sameMonth ? { day: "numeric" } : { month: "long", day: "numeric" })}`;
};

---
<Base title={page.title} description={page.metaDescription}>
  <div class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
        <h1>{page.headline}</h1>
      </div>

      <div class="hero-actions">
        <p>{page.intro}</p>
        <div class="cta">
          <a class="btn btn-p" href="/visit">Plan your visit</a>
          {site.mapUrl && <a class="btn btn-g" href={site.mapUrl}>Get directions</a>}
        </div>
        {tel && <small>Questions before you come? Call the office at <a href={tel}>{site.phone}</a>.</small>}
      </div>

      <div class="hero-times">
        <div class="times">
          <h2>Sunday</h2>
          <p class="where">{site.street}</p>
          <dl>
            {site.sunday.map((s: any) => (
              <div class="row">
                <dt>{s.label}{s.note && <small>{s.note}</small>}</dt>
                <dd>{s.time}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="times">
          <h2>Wednesday</h2>
          <p class="where">Everyone welcome</p>
          <dl>
            {site.wednesday.map((s: any) => (
              <div class="row">
                <dt>{s.label}{s.note && <small>{s.note}</small>}</dt>
                <dd>{s.time}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>

  <Bridge />

  <Sections sections={page.sections ?? []} />

  {events.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">Coming up</p>
        <h2>What's happening next</h2>
        <div class="cards">
          {events.map((e: any) => (
            <article class="card evt">
              {e.image && <img src={e.image} alt="" loading="lazy" decoding="async"
                              width={imageSize(e.image)?.width ?? 480} height={imageSize(e.image)?.height ?? 270} />}
              <p class="meta">{fmtRange(e)}</p>
              <h3>{e.title}</h3>
              {e.description && <p>{e.description}</p>}
              {e.location && <p class="where">{e.location}</p>}
              {e.url && <a href={e.url}>More details</a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
