---
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import Bridge from "../components/Bridge.astro";
import page from "../../content/pages/home.json";
import { site, telHref, upcomingEvents, eventDateRange } from "../lib/site";
import { imageSize } from "../lib/imagesize";
const tel = telHref(site.phone);
const events = upcomingEvents().slice(0, 3);

// Google shows church events in search when they carry Event schema.
const eventSchema = events.length ? events.map((e: any) => ({
  "@context": "https://schema.org", "@type": "Event",
  name: e.title, startDate: e.start, endDate: e.end || undefined,
  description: e.description || undefined,
  image: e.image ? new URL(e.image, Astro.site).href : undefined,
  url: e.url || new URL("/", Astro.site).href,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD", availability: "https://schema.org/InStock",
    url: e.url || new URL("/", Astro.site).href, validFrom: e.start },
  location: { "@type": "Place", name: site.churchName,
    address: { "@type": "PostalAddress", streetAddress: site.street, addressLocality: site.city, addressRegion: "TX", postalCode: site.zip, addressCountry: "US" } },
  organizer: { "@type": "Organization", name: site.churchName, url: Astro.site?.href },
})) : undefined;

const fmtRange = eventDateRange;

---
<Base title={page.title} description={page.metaDescription} schema={eventSchema}>
  <div class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
        <h1>{page.headline}</h1>
      </div>

      <div class="hero-actions">
        <p>{page.intro}</p>
        <div class="cta">
          <a class="btn btn-p" href="/visit/">Plan your visit</a>
          {site.mapUrl && <a class="btn btn-g" href={site.mapUrl}>Get directions</a>}
        </div>
        {tel && <small>Questions before you come? Call the office at <a href={tel}>{site.phone}</a>.</small>}
      </div>

      <div class="hero-times">
        <div class="times">
          <h2>Sunday</h2>
          <p class="where">{site.street}</p>
          <dl>
            {site.sunday.map((s: any) => (
              <div class="row">
                <dt>{s.label}{s.note && <small>{s.note}</small>}</dt>
                <dd>{s.time}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="times">
          <h2>Wednesday</h2>
          <p class="where">Everyone welcome</p>
          <dl>
            {site.wednesday.map((s: any) => (
              <div class="row">
                <dt>{s.label}{s.note && <small>{s.note}</small>}</dt>
                <dd>{s.time}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </div>

  <Bridge />

  <Sections sections={page.sections ?? []} />

  {events.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">Coming up</p>
        <h2>What's happening next</h2>
        <div class="cards">
          {events.map((e: any) => (
            <article class="card evt">
              {e.image && <img src={e.image} alt={e.title} loading="lazy" decoding="async"
                              width={imageSize(e.image)?.width ?? 480} height={imageSize(e.image)?.height ?? 270} />}
              <p class="meta">{fmtRange(e)}</p>
              <h3>{e.title}</h3>
              {e.description && <p>{e.description}</p>}
              {e.location && <p class="where">{e.location}</p>}
              {e.url && <a href={e.url}>More details</a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
