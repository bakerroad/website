---
/** One issue of The Beacon at a permanent address, so a link posted on
 *  Facebook in October still opens October's bulletin in March. */
import Base from "../../layouts/Base.astro";
import BeaconIssue from "../../components/BeaconIssue.astro";
import { allNewsletters, newsletterSlug, longDate } from "../../lib/site";

export function getStaticPaths() {
  const all = allNewsletters();
  return all.map((n, i) => ({
    params: { slug: newsletterSlug(n) },
    props: {
      issue: n,
      newer: i > 0 ? all[i - 1] : null,          // allNewsletters() is newest-first
      older: i < all.length - 1 ? all[i + 1] : null,
    },
  }));
}

const { issue, newer, older } = Astro.props;
const when = longDate(issue.date);
---
<Base
  title={`The Beacon — ${when} | Baker Road Baptist Church`}
  description={issue.summary || `The Beacon, the weekly newsletter of Baker Road Baptist Church in Baytown, Texas, for ${when}.`}
  noindex={true}
>
  <article class="sermon-page">
    <div class="wrap">
      <p class="crumb"><a href="/newsletter/">All issues</a></p>

      <p class="eyebrow">The Beacon</p>
      <h1><time datetime={issue.date}>{when}</time></h1>
      {issue.summary && <p class="smeta">{issue.summary}</p>}

      <BeaconIssue issue={issue} />

      <nav class="prevnext" aria-label="Other issues">
        {older && <a class="pn" href={`/newsletter/${newsletterSlug(older)}/`}><span>Earlier</span>{longDate(older.date)}</a>}
        {newer && <a class="pn next" href={`/newsletter/${newsletterSlug(newer)}/`}><span>Later</span>{longDate(newer.date)}</a>}
      </nav>
    </div>
  </article>
</Base>
