---
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import LiveOrLatest from "../components/LiveOrLatest.astro";
import page from "../../content/pages/watch.json";
import { allSermons, sermonSlug, TZ } from "../lib/site";

const CHANNEL_ID = "UCIMoHSQCKy3dtYCG1Wj607A";
const all = allSermons();
const [latest, ...rest] = all;
const short = (d) =>
  new Date(String(d) + "T12:00:00").toLocaleDateString("en-US", { timeZone: TZ, month: "short", day: "numeric", year: "numeric" });
---
<Base title={page.title} description={page.metaDescription}>
  <div class="phead">
    <div class="wrap">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.headline}</h1>
      {page.intro && <p class="lede">{page.intro}</p>}
    </div>
  </div>

  {latest && (
    <LiveOrLatest sermon={latest} slug={sermonSlug(latest)} channelId={CHANNEL_ID} />
  )}

  {rest.length > 0 && (
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">Archive</p>
        <h2>Earlier messages</h2>
        <ul class="slist">
          {rest.map((s) => (
            <li>
              <a href={`/watch/${sermonSlug(s)}`}>
                <span class="t">{s.title}{s.series ? ` (${s.series})` : ""}</span>
              </a>
              <time datetime={s.date}>{short(s.date)}</time>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Sections sections={page.sections ?? []} />
</Base>
