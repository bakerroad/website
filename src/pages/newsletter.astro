---
/** The Beacon. One issue: the current one. Nothing else.
 *
 *  There is no archive, on purpose. A bulletin is the most perishable thing
 *  the church produces — it is a rota, a set of times and a list of names for
 *  one week — and a pile of old ones is a pile of things that are no longer
 *  true. So the newest issue is the page, and posting next week's is what
 *  removes this week's. Nobody has to remember to tidy up.
 *
 *  Older issues are not deleted, only unpublished: their files stay in the
 *  repository and in its history, so an issue can be brought back by dating a
 *  new one, and nothing is ever actually lost.
 *
 *  Not indexed by Google either. A bulletin carries the children's ministry
 *  rota, volunteer names and the week's giving figures. Members reach it from
 *  the menu; it has no business being a search result. */
import Base from "../layouts/Base.astro";
import Sections from "../components/Sections.astro";
import BeaconIssue from "../components/BeaconIssue.astro";
import page from "../../content/pages/newsletter.json";
import { allNewsletters, longDate } from "../lib/site";

const latest = allNewsletters()[0];
---
<Base title={page.title} description={page.metaDescription} noindex={true}>
  <div class="phead">
    <div class="wrap">
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.headline}</h1>
      {page.intro && <p class="lede">{page.intro}</p>}
    </div>
  </div>

  {latest ? (
    <section class="sec beacon-sec" aria-labelledby="current-issue">
      <div class="wrap">
        {/* The date is the label. "This week" would be a claim the page cannot
            keep — it is built once and then sits there, so a week with no new
            issue would leave it saying something untrue. */}
        <p class="eyebrow">Current issue</p>
        <h2 id="current-issue"><time datetime={latest.date}>{longDate(latest.date)}</time></h2>
        {latest.summary && <p class="archive-note">{latest.summary}</p>}
        <BeaconIssue issue={latest} />
      </div>
    </section>
  ) : (
    <section class="sec"><div class="wrap">
      <p class="archive-note">This week's Beacon will appear here as soon as it is added.</p>
    </div></section>
  )}

  <Sections sections={page.sections ?? []} />
</Base>
