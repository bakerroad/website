  <script is:inline>
    (function () {
      var btn = document.getElementById('expandAll');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var folds = document.querySelectorAll('details.fold');
        var anyClosed = false;
        folds.forEach(function (d) { if (!d.open) anyClosed = true; });
        folds.forEach(function (d) { d.open = anyClosed; });
        btn.textContent = anyClosed ? 'Close every section' : 'Open every section';
      });
      // If someone follows a link into a folded section, open it.
      function openTarget() {
        var id = location.hash.slice(1);
        if (!id) return;
        var el = document.getElementById(id);
        while (el) {
          if (el.tagName === 'DETAILS') el.open = true;
          el = el.parentElement;
        }
        var t = document.getElementById(id);
        if (t) t.scrollIntoView();
      }
      window.addEventListener('hashchange', openTarget);
      openTarget();
      // Printing should give you the whole manual, not the headings.
      window.addEventListener('beforeprint', function () {
        document.querySelectorAll('details.fold').forEach(function (d) { d.open = true; });
      });
    })();
  </script>

